# Banco (Neon / Vercel Postgres)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Auth.js — gere com: npx auth secret
AUTH_SECRET=""

# Microsoft Entra ID (app registrado no tenant da Proative)
# Redirect URI: https://<dominio>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<TENANT_ID>/v2.0"

# Admin(s) inicial(is), separados por vírgula
INITIAL_ADMIN_EMAILS="fernando.souza@proativetec.com.br"

# Vercel Blob (store privado). Sem isso, arquivos vão para .storage/ (só dev)
BLOB_READ_WRITE_TOKEN=""
# ou, na Vercel, BLOB_STORE_ID (OIDC) criado pela integração

# Retenção do áudio das gravações (dias)
AUDIO_RETENTION_DAYS="180"

# Só em desenvolvimento: habilita login sem Microsoft para usuários já existentes
DEV_LOGIN="0"

# Claude (plataforma Anthropic) — redige a ata a partir da transcrição. Sem a chave, o botão fica desligado.
ANTHROPIC_API_KEY=""
# Opcional: modelo (padrão claude-opus-5-5)
CLAUDE_MODEL=""

# E-mail de convite. Opção 1: Resend (domínio verificado). Opção 2 (automática): conta Microsoft do admin com Mail.Send.
RESEND_API_KEY=""
MAIL_FROM="Proative 2.0 <portal@proativetec.com.br>"
# Cópia em todo convite (separe por vírgula)
MAIL_CC="fernando.souza@proativetec.com.br"
# Endereço público do portal, usado nos e-mails
NEXT_PUBLIC_APP_URL="https://proative-2-0.vercel.app"
