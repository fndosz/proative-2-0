// Proative 2.0 — modelo de dados da v1 (+ estrutura do módulo Plaud → ata)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ───────────── Autenticação (Auth.js) ─────────────

enum Role {
  ADMIN
  DIRETORIA
  CONSULTOR
  LEITOR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(LEITOR)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  directorates DirectorateMember[]

  meetingsCreated  Meeting[]         @relation("MeetingCreatedBy")
  participations   MeetingParticipant[]
  actionsOwned     ActionItem[]      @relation("ActionOwner")
  actionsCreated   ActionItem[]      @relation("ActionCreatedBy")
  comments         ActionComment[]
  documentsCreated Document[]        @relation("DocumentCreatedBy")
  notesCreated     Note[]
  versionsUploaded DocumentVersion[]
  documentGrants   DocumentAccess[]
  events           AuditEvent[]
  invitesSent      Invite[]          @relation("InvitedBy")
  minutesApproved  MinutesVersion[]  @relation("MinutesApprovedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  ext_expires_in    Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Convite: só entra quem foi convidado pelo admin (login via Microsoft 365)
model Invite {
  id            String    @id @default(cuid())
  email         String    @unique
  role          Role      @default(LEITOR)
  directorateIds String[]
  invitedById   String?
  invitedBy     User?     @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
}

// ───────────── Diretorias ─────────────

model Directorate {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  members   DirectorateMember[]
  meetings  Meeting[]
  actions   ActionItem[]
  documents Document[]
  goals     Goal[]
  notes     Note[]
}

enum DirectorateAccess {
  LEITURA
  EDICAO
}

model DirectorateMember {
  userId        String
  directorateId String
  access        DirectorateAccess @default(LEITURA)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  directorate Directorate @relation(fields: [directorateId], references: [id], onDelete: Cascade)

  @@id([userId, directorateId])
}

model Goal {
  id            String    @id @default(cuid())
  directorateId String
  title         String
  description   String?
  dueDate       DateTime?
  createdAt     DateTime  @default(now())

  directorate Directorate @relation(fields: [directorateId], references: [id], onDelete: Cascade)
}

// ───────────── Reuniões e atas ─────────────

enum MeetingStatus {
  AGENDADA
  REALIZADA
  CANCELADA
}

model Meeting {
  id            String        @id @default(cuid())
  title         String
  type          String        @default("Reunião") // Conselho, Diretoria, Consultoria…
  date          DateTime
  location      String?
  status        MeetingStatus @default(AGENDADA)
  archivedAt    DateTime?     // arquivada: sai das listas, mas fica no histórico
  directorateId String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  directorate  Directorate?         @relation(fields: [directorateId], references: [id])
  createdBy    User                 @relation("MeetingCreatedBy", fields: [createdById], references: [id])
  participants MeetingParticipant[]
  minutes      Minutes?
  actions      ActionItem[]
  documents    DocumentLink[]
  recordings   Recording[]

  @@index([date])
  @@index([directorateId, archivedAt])
}

model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  userId    String?
  name      String  // permite participante externo sem conta
  role      String? // Presidente, Secretário, Conselheiro…
  present   Boolean @default(true)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
}

enum MinutesStatus {
  RASCUNHO
  EM_REVISAO
  APROVADA
}

model Minutes {
  id        String        @id @default(cuid())
  meetingId String        @unique
  status    MinutesStatus @default(RASCUNHO)
  // Modelo Proative: ordem do dia, deliberações, assuntos gerais, decisões, encaminhamentos, encerramento
  agenda      String @default("") @db.Text
  discussions String @default("") @db.Text
  generalTopics String @default("") @db.Text
  closing     String @default("") @db.Text
  // Rascunho livre / transcrição (Plaud, anotações) — fica no histórico e alimenta a geração da ata pelo Claude
  transcript          String    @default("") @db.Text
  transcriptUpdatedAt DateTime?
  aiGeneratedAt       DateTime?
  aiModel             String?
  aiCostCents         Int       @default(0)
  updatedAt   DateTime @updatedAt

  meeting   Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  decisions Decision[]
  referrals Referral[]
  versions  MinutesVersion[]
  messages  MinutesMessage[]
}

enum ChatRole {
  USER
  ASSISTANT
}

// Conversa com o assistente da ata (pedidos de ajuste, resumos); fica no histórico da ata
model MinutesMessage {
  id         String   @id @default(cuid())
  minutesId  String
  role       ChatRole
  content    String   @db.Text
  operations Json?    // alterações aplicadas pelo assistente nesta resposta
  costCents  Int      @default(0)
  authorId   String?
  createdAt  DateTime @default(now())

  minutes Minutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)

  @@index([minutesId, createdAt])
}

enum DecisionStatus {
  PENDENTE
  DECIDIDA
}

model Decision {
  id        String         @id @default(cuid())
  minutesId String
  text      String         @db.Text
  status    DecisionStatus @default(DECIDIDA)
  createdAt DateTime       @default(now())

  minutes Minutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
}

// Encaminhamento: pode ser convertido em ação
model Referral {
  id          String    @id @default(cuid())
  minutesId   String
  text        String    @db.Text
  ownerName   String?
  dueDate     DateTime?
  actionId    String?   @unique
  createdAt   DateTime  @default(now())

  minutes Minutes     @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  action  ActionItem? @relation(fields: [actionId], references: [id])
}

// Versão congelada da ata (cada aprovação gera uma)
model MinutesVersion {
  id           String   @id @default(cuid())
  minutesId    String
  number       Int
  snapshot     Json
  approvedById String?
  approvedAt   DateTime @default(now())

  minutes    Minutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation("MinutesApprovedBy", fields: [approvedById], references: [id])

  @@unique([minutesId, number])
}

// ───────────── Plano de ação ─────────────

enum ActionStatus {
  NAO_INICIADA
  EM_ANDAMENTO
  BLOQUEADA
  CONCLUIDA
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
}

model ActionItem {
  id            String       @id @default(cuid())
  title         String
  description   String?      @db.Text
  status        ActionStatus @default(NAO_INICIADA)
  priority      Priority     @default(MEDIA)
  dueDate       DateTime?
  ownerId       String?
  directorateId String?
  meetingId     String?      // origem
  createdById   String
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  owner       User?           @relation("ActionOwner", fields: [ownerId], references: [id])
  createdBy   User            @relation("ActionCreatedBy", fields: [createdById], references: [id])
  directorate Directorate?    @relation(fields: [directorateId], references: [id])
  meeting     Meeting?        @relation(fields: [meetingId], references: [id])
  referral    Referral?
  comments    ActionComment[]
  documents   DocumentLink[]

  @@index([status])
  @@index([dueDate])
  @@index([directorateId])
  @@index([ownerId])
  @@index([meetingId])
}

model ActionComment {
  id        String   @id @default(cuid())
  actionId  String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  action ActionItem @relation(fields: [actionId], references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id])
}

// ───────────── Biblioteca ─────────────

model Document {
  id            String   @id @default(cuid())
  title         String
  description   String?
  tags          String[]
  directorateId String?
  restricted    Boolean  @default(false) // true = só quem está em DocumentAccess (+ admin)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  directorate Directorate?      @relation(fields: [directorateId], references: [id])
  createdBy   User              @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  versions    DocumentVersion[]
  links       DocumentLink[]
  access      DocumentAccess[]

  @@index([title])
  @@index([directorateId, updatedAt])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  number       Int
  fileName     String
  mimeType     String
  size         Int
  blobPathname String   // caminho privado no Blob; nunca exposto ao navegador
  uploadedById String
  createdAt    DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, number])
}

model DocumentLink {
  id         String  @id @default(cuid())
  documentId String
  meetingId  String?
  actionId   String?

  document Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  meeting  Meeting?    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  action   ActionItem? @relation(fields: [actionId], references: [id], onDelete: Cascade)
}

model DocumentAccess {
  documentId String
  userId     String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
}

// ───────────── Módulo Plaud → transcrição → ata ─────────────

enum RecordingStatus {
  ENVIADO
  TRANSCREVENDO
  TRANSCRITO
  GERANDO_ATA
  RASCUNHO_PRONTO
  ERRO
}

model Recording {
  id            String          @id @default(cuid())
  meetingId     String
  fileName      String
  mimeType      String
  size          Int
  blobPathname  String
  durationSec   Int?
  status        RecordingStatus @default(ENVIADO)
  errorMessage  String?
  transcript    Json?           // segmentos: { speaker, start, end, text }
  speakerMap    Json?           // { "A": participantId }
  sttProvider   String?
  sttCostCents  Int             @default(0)
  llmCostCents  Int             @default(0)
  retainUntil   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

// ───────────── Auditoria / Histórico ─────────────

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   // ex.: "meeting.create", "action.status"
  entityType String
  entityId   String
  summary    String
  data       Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// ───────────── Anotações (registros rápidos sem ata formal) ─────────────

model Note {
  id            String    @id @default(cuid())
  title         String
  date          DateTime
  directorateId String?
  participants  String?   // texto livre: quem estava
  body          String    @db.Text
  tags          String[]
  meetingId     String?   // preenchido quando a anotação vira uma reunião com ata
  createdById   String
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  directorate Directorate? @relation(fields: [directorateId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id])

  @@index([date])
  @@index([directorateId, archivedAt])
}

// ───────────── Log de acesso e performance ─────────────

enum AccessKind {
  PAGE
  ACTION
  API
  AUTH
  ERROR
}

model AccessLog {
  id         String     @id @default(cuid())
  userId     String?
  kind       AccessKind
  path       String
  name       String?    // nome da ação/função quando conhecido
  status     Int        @default(200)
  durationMs Int?
  error      String?
  ip         String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@index([path, createdAt])
}
